# Network Device Credentials
NET_USER=your_tacacs_username
NET_PASS=your_tacacs_password

# Switch IP Addresses
SWITCH_1_IP=<device ip>
SWITCH_2_IP=<device ip>

# Webex Webhook Configuration
WEBEX_WEBHOOK_URL=https://webexapis.com/v1/webhooks/incoming/...

# SMTP Email Relay Configuration
MAIL_SERVER=smtp.yourdomain.com
MAIL_PORT=25
MAIL_FROM=network-audit@yourdomain.com
MAIL_TO=netops@yourdomain.com
